APP_NAME=Farvision Automation API
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

LOG_LEVEL=INFO
LOG_DIR=logs

API_V1_PREFIX=/api/v1

CORS_ORIGINS=http://localhost:3000

GOOGLE_CREDENTIALS_PATH=credentials/service-account.json
# For serverless (Vercel): base64-encoded service-account JSON instead of a file.
# GOOGLE_CREDENTIALS_JSON_BASE64=eyJhbGciOiJSUzI1NiIs...

STATEMENT_MASTER_SHEET_ID=your-statement-master-sheet-id
DEPOSIT_WITHDRAWAL_SHEET_ID=your-deposit-withdrawal-sheet-id
RECEIPT_PAYMENT_SHEET_ID=your-receipt-payment-sheet-id

SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# One-time migration seed only for the dashboard login password (see
# app_config_repository.py) - not read after the first successful login.
ACCESS_PASSWORD=

# Static secret shared with the frontend's /api/clear-sheet proxy route.
INTERNAL_API_SECRET=

# Password-reset email delivery (Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
PASSWORD_RESET_RECIPIENT_EMAIL=
PASSWORD_RESET_BASE_URL=https://fv.tallstone.in
