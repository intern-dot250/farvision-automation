{
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.11", "maxDuration": 60 }
    }
  ],
  "routes": [
    { "src": "/api/v1/(.*)", "dest": "backend/api/index.py" }
  ]
}
